{
  "name": "meme-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Meme Studio — 网页版音频切片乐器（切片→调音→编排→导出）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release --manifest-path wasm/Cargo.toml && node scripts/copy-wasm.mjs",
    "verify:stretch": "node scripts/verify-stretch.mjs"
  },
  "dependencies": {
    "@audio/shift-delay": "^1.0.2",
    "@audio/shift-formant": "^1.1.4",
    "@audio/shift-granular": "^1.0.2",
    "@audio/shift-hpss": "^1.0.2",
    "@audio/shift-hybrid": "^1.0.2",
    "@audio/shift-lpc": "^1.0.2",
    "@audio/shift-ola": "^1.0.3",
    "@audio/shift-paulstretch": "^1.1.4",
    "@audio/shift-psola": "^1.0.3",
    "@audio/shift-pvoc": "^1.1.4",
    "@audio/shift-pvoc-lock": "^1.0.2",
    "@audio/shift-sample": "^1.0.2",
    "@audio/shift-sms": "^1.0.2",
    "@audio/shift-transient": "^1.0.2",
    "@audio/shift-wsola": "^1.0.3",
    "@audio/stretch-psola": "^1.2.1",
    "@audio/stretch-wsola": "^1.2.1",
    "@soundtouchjs/core": "^2.1.1",
    "@soundtouchjs/stretch-phase-vocoder": "^2.1.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@tonejs/midi": "^2.0.28",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "pinyin-pro": "^3.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4",
    "wavesurfer.js": "^7.8.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
